{
  "unicode_form": "NFC",
  "strip_zero_width": true,
  "collapse_whitespace": true,
  "preserve_newlines": true,
  "lowercase": false,
  "reduce_repetitions": false,
  "max_repeats": 2,
  "normalize_variants": false,
  "variant_policy": "conservative",
  "protected_modes": {
    "URL": "preserve",
    "EMAIL": "preserve",
    "MENTION": "preserve",
    "HASHTAG": "preserve",
    "EMOJI": "preserve",
    "NUMBER": "preserve"
  },
  "failure_policy": "skip_with_warning"
}
